{
  "rules": {
    ".read": false,
    ".write": false,
    "hackathon": {
      "state": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "votes": {
        ".read": "auth != null",
        "$target": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && ( $target === 'team1' || $target === 'team2' )",
            ".validate": "newData.hasChildren(['criteria','total','createdAt'])"
          }
        }
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    }
  }
}